# ── Required ──────────────────────────────────────────────────────────────────
SECRET_KEY=change_this_to_a_long_random_string

# ── Database ──────────────────────────────────────────────────────────────────
# Local dev (default — no need to set):
# DATABASE_URL=sqlite:///./conflux.db
#
# Railway production with persistent volume mounted at /data:
# DATABASE_URL=sqlite:////data/conflux.db

# ── AI (optional — mock mode if not set) ──────────────────────────────────────
OPENROUTER_API_KEY=sk-or-v1-...

# ── CORS ──────────────────────────────────────────────────────────────────────
# Local dev (default — no need to set):
# CORS_ORIGINS=http://localhost:5173,http://localhost:3000
#
# Production — set to your Vercel frontend URL:
# CORS_ORIGINS=https://conflux.vercel.app
